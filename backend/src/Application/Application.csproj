<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- Round 21 (B2): the reviewed stratified sample travels with the image so
         the public accuracy measure is backed by committed evidence, never a
         hardcoded number. -->
    <EmbeddedResource Include="Quality/Data/classification-evaluation-2026-11-05.json" />
    <!-- Round 22 (C1): the versioned Data & Analytics sub-role taxonomy travels
         with the image so API results and UI disclosure cannot drift. -->
    <EmbeddedResource Include="Jobs/Data/data-subrole-taxonomy.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
