DATABASE_URL=Host=localhost;Port=55432;Database=nz_job_market;Username=postgres;Password=postgres
POSTGRES_DB=nz_job_market
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
VITE_API_BASE_URL=http://localhost:5050
# Round 13: shared secret for the crawler health view (/health + /api/admin/health).
# Leave empty to fail closed (the backend then refuses every health request with
# 401). Set a strong value here and the verify scripts / health watcher pick it
# up from the environment.
HEALTH_ACCESS_PASSWORD=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Firecrawl fetch layer. Point FIRECRAWL_BASE_URL at a self-hosted stack (for
# example http://192.168.88.16:3002/v2) to enable `fetcher: "firecrawl"` sources
# and the automatic browser-failure fallback. The worker enforces robots.txt
# before every Firecrawl scrape, so the instance is never a robots bypass.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_TIMEOUT_SECONDS=60
SCRAPLING_FETCHER_TYPE=fetcher
SCRAPLING_PYTHON_EXECUTABLE=crawler/.venv/bin/python
SCRAPLING_WORKER_SCRIPT=
SCRAPLING_ROBOTS_TXT_OBEY=true
SCRAPLING_CONCURRENCY=2
SCRAPLING_DOWNLOAD_DELAY_SECONDS=5
SCRAPLING_TIMEOUT_SECONDS=360
SCRAPLING_PROXY_URL=
TRADEME_CONSUMER_KEY=
TRADEME_CONSUMER_SECRET=
CRAWLER_JOB_STALE_DAYS=15
CRAWLER_MISSING_CRAWL_THRESHOLD=2
CRAWLER_MAX_PAGES_PER_RUN=50
CRAWLER_RETENTION_DAYS=20
CRAWLER_DELAY_SECONDS=5
CRAWLER_POLL_SECONDS=60
AI_EXTRACTION_ENABLED=false
# Optional OpenAI-compatible enrichment. Off unless AI_EXTRACTION_ENABLED=true
# and OPENAI_API_KEY is set; deterministic extraction always wins over AI.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_EXTRACTION_BATCH_SIZE=10
